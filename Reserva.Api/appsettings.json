{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SecurityOptions": {
    "Issuer": "ReservaApi",
    "Audience": "ReservaApiClient",
    "SecurityKey": "hVycdVeUJznH3crdu4VAyDRwD6DNu2Ju"
  },
  "AppSettings": {
    "DefaultCulture": "es-ES"
  },
  "SignInOptions": {
    "LockoutEnabled": true,
    "SendMailOnSignUp": true,
    "LockoutMaxFailedAccessAttempts": 3,
    "LockoutDefaultTimeSpanInMinutes": 5
  },
  "Pago": {
    "MinutosExpiracion": 15,
    "PorcentajeMinimoAdelanto": 50,
    // Configuración para transferencias bancarias (FUTURO)
    "Transferencia": {
      "NumeroCuenta": "PENDIENTE DE CONFIGURAR",
      "CCI": "PENDIENTE DE CONFIGURAR",
      "NombreBanco": "Banco BCP",
      "TitularCuenta": "PENDIENTE DE CONFIGURAR"
    }
  },
  // ========================================
  // Configuración de Izipay (Yape/Plin)
  // ========================================
  // Documentación: https://developers.izipay.pe/
  // Obtén tus credenciales en el BackOffice de Izipay
  "Izipay": {
    // Endpoint de la API de Izipay
    "ApiUrl": "https://api.micuentaweb.pe/api-payment/V4/Charge",

    // Credenciales de autenticación (Basic Auth)
    // Reemplaza con tus credenciales reales del BackOffice de Izipay
    "Username": "TU_USERNAME_IZIPAY",
    "Password": "TU_PASSWORD_IZIPAY",

    // Clave HMAC-SHA256 para validar webhooks
    // Esta clave se usa para verificar que las notificaciones vienen realmente de Izipay
    "HmacSha256Key": "TU_HMAC_SHA256_KEY",

    // Clave pública (si es necesaria para el frontend)
    "PublicKey": "TU_PUBLIC_KEY_IZIPAY",

    // URL de la página de pago de Izipay
    "PaymentPageUrl": "https://secure.micuentaweb.pe/payment",

    // URLs de retorno después del pago
    "SuccessUrl": "https://tuapp.com/pago-exitoso",
    "FailureUrl": "https://tuapp.com/pago-fallido",

    // URL del webhook que recibirá las notificaciones de Izipay
    // IMPORTANTE: Debe ser accesible públicamente (no localhost)
    // Configura esta URL en el BackOffice de Izipay
    "WebhookUrl": "https://tuapi.com/api/IzipayWebhook/notification"
  }
}
